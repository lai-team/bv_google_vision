# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Editors / IDEs / tooling
.claude/
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/

# Credentials -- the Google service account keyfile must NEVER be committed.
# It is referenced by GOOGLE_APPLICATION_CREDENTIALS and belongs outside the
# web root entirely. See README.
*.json.key
*credentials*.json
*service-account*.json
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json

# Local config & secrets
.env
.env.*
!.env.example

# Logs
*.log
debug.log
error_log

# NOTE: /vendor/ is deliberately NOT ignored. index.php:11 requires
# vendor/autoload.php, and the plugin is deployed by copying the tree, so a
# checkout without vendor/ fatals on load. composer.lock is committed with it.
